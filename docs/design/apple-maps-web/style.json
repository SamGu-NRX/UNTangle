{
  "version": 8,
  "name": "UNTangle · campus light",
  "metadata": {
    "untangle:direction": "Quiet campus atlas. White building massing, sparse labels, green only for the selected walk.",
    "untangle:source-checked": "2026-10-13: live OpenFreeMap TileJSON and Liberty style",
    "untangle:campus-labels": "Sample names and centroids from frontend/src/lib/campus-locations.ts. Replace with the full campus catalogue, not building tile properties.",
    "untangle:extrusions": "Fade from zoom 15.5 to 16.5 to retain flat overview legibility. This is a design starting point, not a measured performance threshold.",
    "untangle:selection-color": "#007a40; runtime overlays only"
  },
  "center": [-97.1477, 33.2108],
  "zoom": 15.5,
  "bearing": 0,
  "pitch": 0,
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "transition": { "duration": 0, "delay": 0 },
  "light": { "anchor": "viewport", "color": "#ffffff", "intensity": 0.28, "position": [1.5, 215, 40] },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "<a href=\"https://openfreemap.org\">OpenFreeMap</a> <a href=\"https://www.openmaptiles.org/\">© OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
    },
    "unt-campus-labels": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": [
          { "type": "Feature", "id": "gab", "properties": { "name": "General Academic Building", "code": "GAB", "priority": 1 }, "geometry": { "type": "Point", "coordinates": [-97.1481479, 33.2131868] } },
          { "type": "Feature", "id": "life", "properties": { "name": "Life Sciences Complex", "code": "LIFE", "priority": 2 }, "geometry": { "type": "Point", "coordinates": [-97.1490327, 33.2121465] } },
          { "type": "Feature", "id": "blb", "properties": { "name": "Business Leadership Building", "code": "BLB", "priority": 3 }, "geometry": { "type": "Point", "coordinates": [-97.1476988, 33.2088704] } }
        ]
      }
    }
  },
  "layers": [
    { "id": "land", "type": "background", "paint": { "background-color": "#eeede9" } },
    { "id": "campus-land", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "filter": ["match", ["get", "class"], ["school", "college", "university"], true, false], "paint": { "fill-color": "#e7e9e1" } },
    { "id": "grass", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["match", ["get", "class"], ["grass", "wood"], true, false], "paint": { "fill-color": ["match", ["get", "class"], "wood", "#d7e3cf", "#dde8d5"], "fill-opacity": 0.85 } },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park", "paint": { "fill-color": "#dbe7d2", "fill-opacity": 0.7 } },
    { "id": "recreation", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "filter": ["match", ["get", "class"], ["pitch", "recreation_ground", "cemetery"], true, false], "paint": { "fill-color": "#d8e4ce", "fill-opacity": 0.8 } },
    { "id": "parking", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "minzoom": 14, "filter": ["==", ["get", "class"], "parking"], "paint": { "fill-color": "#e2e1dd" } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": { "fill-color": "#c4dfe9" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "minzoom": 12, "paint": { "line-color": "#c4dfe9", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 18, 4] } },
    { "id": "road-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false], "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#d7d6d1", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 12, 2, 16, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 14, ["secondary", "tertiary"], 11, 7], 19, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 44, ["secondary", "tertiary"], 34, 22]] } },
    { "id": "road-surface", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false], "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 12, 1, 16, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 12, ["secondary", "tertiary"], 9, 5], 19, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 41, ["secondary", "tertiary"], 31, 19]] } },
    { "id": "walkway-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 14, "filter": ["match", ["get", "class"], ["path", "pedestrian", "track"], true, false], "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#d8d9d1", "line-width": ["interpolate", ["linear"], ["zoom"], 14, 1.5, 17, 4, 20, 9] } },
    { "id": "walkway-surface", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 14, "filter": ["match", ["get", "class"], ["path", "pedestrian", "track"], true, false], "layout": { "line-cap": "round", "line-join": "round" }, "paint": { "line-color": "#fafaf6", "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.7, 17, 2.6, 20, 7] } },
    { "id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 13, "filter": ["==", ["get", "class"], "rail"], "paint": { "line-color": "#c5c4be", "line-width": 1.5, "line-dasharray": [3, 2] } },
    { "id": "building-footprint", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13, "paint": { "fill-color": "#e0dfda", "fill-outline-color": "#cdcdc6" } },
    { "id": "building-3d", "type": "fill-extrusion", "source": "openmaptiles", "source-layer": "building", "minzoom": 15.5, "filter": ["!=", ["get", "hide_3d"], true], "paint": { "fill-extrusion-color": ["interpolate", ["linear"], ["to-number", ["get", "render_height"], 0], 0, "#f7f6f2", 45, "#e7e7e2"], "fill-extrusion-height": ["max", 0, ["to-number", ["get", "render_height"], 0]], "fill-extrusion-base": ["min", ["max", 0, ["to-number", ["get", "render_height"], 0]], ["max", 0, ["to-number", ["get", "render_min_height"], 0]]], "fill-extrusion-opacity": ["interpolate", ["cubic-bezier", 0.23, 1, 0.32, 1], ["zoom"], 15.5, 0, 16.5, 0.9], "fill-extrusion-vertical-gradient": true } },
    { "id": "campus-building-label", "type": "symbol", "source": "unt-campus-labels", "minzoom": 15.5, "layout": { "text-field": ["step", ["zoom"], ["get", "code"], 16.6, ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 15.5, 12, 18, 14], "text-anchor": "bottom", "text-offset": [0, -1.8], "text-max-width": 11, "text-padding": 5, "symbol-sort-key": ["get", "priority"], "text-allow-overlap": false }, "paint": { "text-color": "#343b35", "text-halo-color": "#ffffff", "text-halo-width": 1.7, "text-halo-blur": 0.25 } },
    { "id": "road-label", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 14, "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false], "layout": { "symbol-placement": "line", "symbol-spacing": 350, "text-field": ["coalesce", ["get", "name:en"], ["get", "name_en"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 14, 10, 18, 12], "text-max-angle": 25 }, "paint": { "text-color": "#676b64", "text-halo-color": "#ffffff", "text-halo-width": 1.3 } },
    { "id": "park-label", "type": "symbol", "source": "openmaptiles", "source-layer": "park", "minzoom": 15, "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name_en"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 11, "text-max-width": 10, "text-padding": 16 }, "paint": { "text-color": "#586653", "text-halo-color": "#eef3e9", "text-halo-width": 1 } },
    { "id": "poi-label", "type": "symbol", "source": "openmaptiles", "source-layer": "poi", "minzoom": 17.5, "filter": ["all", ["==", ["geometry-type"], "Point"], ["<=", ["to-number", ["get", "rank"], 99], 6], ["match", ["get", "class"], ["library", "hospital", "bus", "cafe"], true, false]], "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name_en"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 11, "text-max-width": 9, "text-padding": 24, "symbol-sort-key": ["to-number", ["get", "rank"], 99] }, "paint": { "text-color": "#666963", "text-halo-color": "#ffffff", "text-halo-width": 1.4 } },
    { "id": "place-label", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "maxzoom": 15, "filter": ["match", ["get", "class"], ["city", "town", "suburb", "neighbourhood"], true, false], "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name_en"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 10, 14, 14, 17], "text-padding": 24 }, "paint": { "text-color": "#596158", "text-halo-color": "#eeede9", "text-halo-width": 2 } }
  ]
}
