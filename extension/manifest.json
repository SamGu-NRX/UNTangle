{
  "manifest_version": 3,
  "name": "UNTangle Class Search",
  "version": "0.1.0",
  "description": "Review class-search conflicts and confirm sections in UNTangle.",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "http://127.0.0.1:3217/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "UNTangle Class Search"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:4317/class-search*",
        "https://class-search.myunt.example.invalid/*",
        "https://class-search-frame.myunt.example.invalid/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
