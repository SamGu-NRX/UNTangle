# UNTangle frontend environment template.
# Copy to frontend/.env and fill in. Every variable and its behavior is
# documented in frontend/README.md.
#
# The root `bun dev` / `bun setup` script (scripts/dev.mjs) rewrites
# BACKEND_URL and BETTER_AUTH_URL below on every run; other keys you add
# are preserved.

# --- Backend API (course/instructor grade data) ---
# Server-side base URL for grade fetches. Without either backend variable,
# localhost:3001/3002/3011 are probed and grade pages degrade.
BACKEND_URL=http://localhost:3001
# Optional alias that is also inlined into client bundles (NEXT_PUBLIC_*).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# --- Auth (better-auth: email/password sign-in, password reset) ---
# Public origin of this frontend; auth base URL and trusted origin.
BETTER_AUTH_URL=http://localhost:3000
# Long random string. There is an insecure development default — set a real
# value anywhere beyond local development.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# --- PostgreSQL (auth data + saved planner state) ---
# Preferred: one connection string. Without DATABASE_URL, the pool falls back
# to the discrete PG* variables below, and saved-plan sync stays disabled.
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/untangle
# Discrete fallback parameters (used when DATABASE_URL is unset).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=untangle
PGUSER=postgres
PGPASSWORD=change-me

# --- Password-reset email (Resend) ---
# Without RESEND_API_KEY, password-reset emails fail; sign-in still works.
RESEND_API_KEY=re_replace_with_your_key
RESEND_FROM_EMAIL="UNTangle <onboarding@resend.dev>"

# --- Campus map (OpenRouteService routing + map tiles) ---
# Without ORS_API_KEY the map still works: stops resolve against the bundled
# UNT building list, but unknown locations cannot be geocoded and routes are
# straight-line approximations instead of foot-walking directions.
ORS_API_KEY=replace-with-your-openrouteservice-key
# Tile layer overrides (defaults: OpenStreetMap tiles, OSM attribution, zoom cap 19).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
NEXT_PUBLIC_MAP_MAX_ZOOM=19

# --- OS username ---
# Not app configuration: only the last-resort fallback for PGUSER when
# PGUSER is unset. Normally leave this unset.
# USER=postgres
