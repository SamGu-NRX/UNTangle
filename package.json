{
  "name": "UNTangle",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "packages/*",
    "tools/repo-rules"
  ],
  "scripts": {
    "setup": "node scripts/dev.mjs --setup-only",
    "frontend:dev": "cd frontend && bun run dev",
    "dev": "node scripts/dev.mjs",
    "dev:turbo": "turbo dev",
    "build": "turbo build",
    "lint": "turbo run lint --continue",
    "typecheck": "turbo run typecheck --continue",
    "test": "turbo run test --continue --env-mode=loose"
  },
  "devDependencies": {
    "eslint": "^9",
    "turbo": "^2.8.19",
    "typescript": "^5",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "bun@1.3.10"
}
